   "source": [
    "x = int(input(\"Number: \"))\n",
    "\n",
    "if x > 0 and x % 2 == 0 :\n",
    "    print(\"Positive even\")\n",
    "\n",
    "elif x > 0 and x % 2 != 0  :\n",
    "    print(\"Positive odd\")\n",
    "\n",
    "elif x < 0 and x % 2 == 0 :\n",
    "    print(\"Negative even\")\n",
    "\n",
    "elif x < 0 and x % 2 != 0 :\n",
    "    print(\"Negative odd\")\n",
    "\n",
    "else :\n",
    "    print(\"Zero\")"
   ]
  }
