   ],
   "source": [
    "income = int(input(\"Monthly income: \"))\n",
    "expenses = int(input(\"Monthly expenses: \"))\n",
    "\n",
    "remaining = income - expenses\n",
    "\n",
    "if remaining > 0 :\n",
    "    print(\"You have money left.\")\n",
    "\n",
    "elif remaining == 0 :\n",
    "    print(\"You broke even.\")\n",
    "\n",
    "else:\n",
    "    print(\"You are spending more than your income.\")"
   ]
  }
